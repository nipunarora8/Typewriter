{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typewriter",
  "version": "0.1.2",
  "identifier": "com.nipunarora.typewriter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Typewriter",
        "width": 380,
        "height": 252,
        "minWidth": 380,
        "minHeight": 252,
        "maxWidth": 380,
        "maxHeight": 252,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4QzZCNzkxMkJFRjBFQjUKUldTMUR1OHJrYmZHV0pZc2N4blU5MmpNYk4yQ0RuTDhwdVRHTUZNajZoR25RMFp3SlEvWTFKdjgK",
      "endpoints": [
        "https://github.com/nipunarora8/Typewriter/releases/latest/download/latest.json"
      ]
    }
  }
}
